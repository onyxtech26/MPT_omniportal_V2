# Copy to backend/.env and fill in. Never commit the real .env (.gitignore covers .env*).

# Signing key for login tokens. Change this in any real deployment.
JWT_SECRET=local-dev-secret-change-in-production

# Where sales data is read from: "file" (CSV, works offline — used by the
# packaged Windows build) or "supabase" (Postgres, required by the assistant).
DATA_SOURCE=file

# Supabase project. The publishable key is intentionally the one used here: its
# role has SELECT only, so no query — including the assistant's — can write.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# AI assistant. Free key from https://build.nvidia.com (format: nvapi-...).
# The endpoint is OpenAI-compatible, so any compatible provider can be swapped
# in by changing NVIDIA_BASE_URL and NVIDIA_MODEL.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
