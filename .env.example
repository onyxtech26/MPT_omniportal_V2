# The sales dashboard itself still needs NO environment variables — the CSV is
# read and processed entirely in the browser. Nothing below is used by it.
#
# The login and watch repair module (docs/REPAIR_MODULE_SPEC.md) talk directly
# to a Supabase project. Both values are PUBLIC by design (the app is a static
# export with no server to hold a real secret) — copy them from the Supabase
# project's API settings, or ask whoever set up the project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Historical note: V1 used NEXT_PUBLIC_BACKEND_URL to reach a Python FastAPI
# server. That server is no longer used by the web app.
